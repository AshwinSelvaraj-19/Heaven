# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Supabase credentials from https://supabase.com/dashboard/project/_/settings/api
# Use the service_role key for full write access.
SUPABASE_URL=
SUPABASE_KEY=

# Permanent voice channel ID for the bot to join and stay connected to
# This is an existing voice channel - the bot will NOT create it
PERMANENT_VOICE_CHANNEL_ID=

# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Supabase credentials from https://supabase.com/dashboard/project/_/settings/api
# The bot also accepts the VITE_-prefixed names auto-provisioned by Bolt:
#   VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY (or VITE_SUPABASE_SERVICE_ROLE_KEY)
# For production prefer the service_role key for write access.
SUPABASE_URL=
SUPABASE_KEY=
